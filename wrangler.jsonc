{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flow-club-rat-race",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
  "FIREBASE_PROJECT_ID": "flow-club-1d62e",
  "FIREBASE_API_KEY": "AIzaSyDZLNx5e2-PdTiWJiN62a1xmWKNLotEtOw",
  "FIREBASE_AUTH_DOMAIN": "flow-club-1d62e.firebaseapp.com",
  "AUTH_PROVIDERS": "google.com"
},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flow-club-db",
      "database_id": "99642076-3535-4d45-8193-ba2b38aacc81"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
