{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flow-club-rat-race",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flow-club-db",
      "database_id": "99642076-3535-4d45-8193-ba2b38aacc81"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
